# ==============================================================================
# KrishiRakshak — Environment Configuration Template
# Copy this file to `.env` and fill in your API credentials.
# ==============================================================================

# LLM Configuration (Groq / OpenAI compatible)
LLM_PROVIDER=openai
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# YOLOv8 Pathology Model Path
YOLO_MODEL_PATH=yolo_weights/plant_disease_38cls.pt

# Service URLs
BACKEND_URL=http://localhost:8000
